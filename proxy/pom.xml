            <artifactId>bungeecord</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Bungee.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>dev.hely.core</groupId>
            <artifactId>bukkit</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
